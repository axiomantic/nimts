{
  "name": "nimts",
  "version": "0.1.0",
  "description": "Seamless TypeScript & WebAssembly bridge for Nim with non-invasive exportts, sync/async loaders, and Future<->Promise bridge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite-plugin-nimts.js",
      "types": "./dist/vite-plugin-nimts.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "c_src",
    "scripts",
    "nimts.nimble",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomantic/nimts.git"
  },
  "bugs": {
    "url": "https://github.com/axiomantic/nimts/issues"
  },
  "homepage": "https://github.com/axiomantic/nimts#readme",
  "keywords": [
    "nim",
    "typescript",
    "wasm",
    "webassembly",
    "vite",
    "bindings"
  ],
  "author": "Axiomantic",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
