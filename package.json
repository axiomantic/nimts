{
  "name": "@axiomantic/nimts",
  "version": "0.0.1",
  "description": "Seamless TypeScript & WebAssembly bridge for Nim with Vite integration, sync/async loaders, and Future<->Promise bridge",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash scripts/compile_wasm.sh && tsc",
    "compile:wasm": "bash scripts/compile_wasm.sh",
    "compile:ts": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "fmt": "npx prettier --write 'ts/**/*.ts' 'tests/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
