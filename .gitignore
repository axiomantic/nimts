# Polyform standard ignore patterns
nimcache/
*.exe
*.out
*.dll
*.so
*.dylib
nimblecache/
.nimble/
htmldocs/
site/
.DS_Store
.idea/
.vscode/
*.swp
justfile.local

# TypeScript / WASM artifacts
node_modules/
dist/
.nimts-cache/
tests/fixtures/nimcache/
tests/fixtures/*.wasm
tests/fixtures/*.js
tests/fixtures/*.mjs
tests/fixtures/*.d.ts
*.o

# Compiled binaries
/nimts
tests/test_*
!tests/test_*.nim
!tests/test_*.ts
!tests/test_*.py

# Python caches
__pycache__/
.pytest_cache/
.testmondata
.venv/
uv.lock

# VitePress documentation
docs/.vitepress/dist/
docs/.vitepress/cache/

# Vite public output
public/

# Vine workspaces
.vine/
.vine.json
.envrc
